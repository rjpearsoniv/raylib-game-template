{
    "configurations": [
        {
            "name": "Win32-w64devkit",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/../raylib/src"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "PLATFORM_DESKTOP"
            ],
            "compilerPath": "C:/w64devkit/bin/gcc.exe",
            "cStandard": "c99",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64",
            "configurationProvider": "ms-vscode.makefile-tools"
        }
    ],
    "version": 4
}
